<ContentDialog
    x:Class="FolderCrypto.App.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="解密"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    Closed="OnClosed">

    <StackPanel Width="380" Spacing="12" Padding="0,4,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72E;" FontSize="22"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock
                Text="解锁"
                Style="{ThemeResource SubtitleTextBlockStyle}"/>
        </StackPanel>

        <TextBlock
            x:Name="NameText"
            TextWrapping="Wrap"
            Text="请输入密码以解锁。"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- 输入模式切换：密码 / 恢复码 -->
        <ToggleSwitch x:Name="ModeSwitch"
                      Header="使用恢复码"
                      OffContent="密码" OnContent="恢复码"
                      Toggled="OnModeToggled"/>

        <PasswordBox
            x:Name="PasswordBox"
            Header="密码" />

        <TextBox
            x:Name="RecoveryBox"
            Header="恢复码 (如 ABCD-EFGH-JKLM-NPQR-STUV-WXYZ)"
            PlaceholderText="输入加密时展示的恢复码"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="AttemptText"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCautionBrush}" />

        <TextBlock
            x:Name="CooldownText"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
    </StackPanel>
</ContentDialog>
