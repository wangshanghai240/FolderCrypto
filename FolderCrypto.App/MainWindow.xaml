<Window
    x:Class="FolderCrypto.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="Transparent" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏拖拽区域 -->
        <Rectangle x:Name="DragTitleBar" Grid.Row="0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Stretch" Fill="Transparent"/>

        <!-- 顶部标题栏（拖拽区内显示小标题） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="40,8,0,8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE72E;" FontSize="18"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="Folder Crypto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 导航 + 内容区 -->
        <controls:NavigationView
            x:Name="MainNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            Background="Transparent"
            SelectionChanged="OnNavSelectionChanged">

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="首页" Tag="Home">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="设置" Tag="Settings">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid>
                <!-- ============ 首页：加密/解密 ============ -->
                <ScrollViewer x:Name="HomeContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="40,8,40,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                        <TextBlock Text="原地加密文件或文件夹，在资源管理器中右键即可加密/解密。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <controls:InfoBar
                            x:Name="StatusBar"
                            Severity="Informational"
                            IsClosable="True"
                            IsOpen="False"
                            Title="提示"
                            Message="提示信息将显示于此"/>

                        <!-- 加密卡片 -->
                        <Border Padding="28" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="加密文件或文件夹" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Text="选择任意文件或文件夹，设置强密码后直接原地加密。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="EncryptFileButton" Content="选择文件加密" Click="OnEncryptFile"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <Button x:Name="EncryptFolderButton" Content="选择文件夹加密" Click="OnEncryptFolder"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 解密卡片 -->
                        <Border Padding="28" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="解密文件或文件夹" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Text="选择已加密的文件或文件夹，输入密码后原地还原。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="DecryptButton" Content="选择文件/文件夹解密" Click="OnDecrypt"/>
                            </StackPanel>
                        </Border>

                        <!-- 使用说明 -->
                        <Border Padding="28" CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="使用提示" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><LineBreak/>
                                <Run Text="· 密码需超过 6 位，并同时包含数字、字母和特殊字符。"/><LineBreak/>
                                <Run Text="· 解密密码连续错误 3 次，输入框将自动关闭。"/><LineBreak/>
                                <Run Text="· 在资源管理器中右键任意文件/文件夹即可选择加密或解密，并显示锁图标。"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 设置页 ============ -->
                <ScrollViewer x:Name="SettingsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="40,8,40,24" Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

                        <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="个性化你的 Folder Crypto 外观。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- 主题卡片 -->
                        <Border Padding="28" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="主题" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </StackPanel>

                                <TextBlock Text="选择应用的主题外观。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <!-- 主题模式单选 -->
                                <RadioButtons x:Name="ThemeModeSelector" Header="主题模式">
                                    <RadioButton x:Name="rbSystem" Content="跟随系统" Tag="System" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="rbLight" Content="浅色" Tag="Light" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="rbDark" Content="深色" Tag="Dark" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="rbCustom" Content="自定义" Tag="Custom" Checked="OnThemeModeChanged"/>
                                </RadioButtons>

                                <!-- 自定义主题详情（仅自定义模式可见） -->
                                <StackPanel x:Name="CustomPanel" Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="自定义基础外观" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <RadioButton x:Name="rbCustomLight" Content="浅色基准" GroupName="CustomBase" IsChecked="True" Checked="OnCustomBaseChanged"/>
                                        <RadioButton x:Name="rbCustomDark" Content="深色基准" GroupName="CustomBase" Checked="OnCustomBaseChanged"/>
                                    </StackPanel>

                                    <TextBlock Text="自定义强调色" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="AccentSwatch1" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#0078D4" Tag="#0078D4" Click="OnAccentSwatch" ToolTipService.ToolTip="蓝色"/>
                                        <Button x:Name="AccentSwatch2" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#107C10" Tag="#107C10" Click="OnAccentSwatch" ToolTipService.ToolTip="绿色"/>
                                        <Button x:Name="AccentSwatch3" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#C42B1C" Tag="#C42B1C" Click="OnAccentSwatch" ToolTipService.ToolTip="红色"/>
                                        <Button x:Name="AccentSwatch4" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#C239B3" Tag="#C239B3" Click="OnAccentSwatch" ToolTipService.ToolTip="紫色"/>
                                        <Button x:Name="AccentSwatch5" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#E81123" Tag="#E81123" Click="OnAccentSwatch" ToolTipService.ToolTip="玫红"/>
                                        <Button x:Name="AccentSwatch6" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#8764B8" Tag="#8764B8" Click="OnAccentSwatch" ToolTipService.ToolTip="紫罗兰"/>
                                        <Button x:Name="AccentSwatch7" CornerRadius="16" Width="32" Height="32" Padding="0"
                                                Background="#FF8C00" Tag="#FF8C00" Click="OnAccentSwatch" ToolTipService.ToolTip="橙色"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AccentPreviewText" Text="当前强调色：#0078D4"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 启动选项卡片 -->
                        <Border Padding="28" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="启动选项" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="跟随系统启动" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="登录 Windows 后自动在后台托盘静默常驻（不弹主界面），让右键加密/解密更快；可通过系统托盘图标打开设置或退出程序。"
                                                   TextWrapping="Wrap" MaxWidth="520"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AutoStartStatusText"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="AutoStartButton"
                                            Content="开启开机自启"
                                            Click="OnAutoStartClick"
                                            MinWidth="110"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:NavigationView>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Padding="40,10,40,14" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="FooterText" Text="就绪"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Window>
