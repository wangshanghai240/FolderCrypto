<Window x:Class="FolderCrypto.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderCrypto 文件夹加密 - 安装"
        Width="540" Height="380"
        MinWidth="540" MinHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 头部 ============ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                Padding="28,22,28,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FolderCrypto"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text=" 文件夹加密"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <TextBlock x:Name="VersionText"
                           Margin="0,6,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="选择安装目录，然后点击“安装”开始安装。"
                           Margin="0,8,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ 主体：目录选择 ============ -->
        <StackPanel Grid.Row="1" Margin="28,24,28,0">
            <TextBlock Text="安装目录"
                       FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox"
                         Grid.Column="0" Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0" FontSize="13"
                         Background="{DynamicResource ControlBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                         CaretBrush="{DynamicResource TextPrimary}" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1" Content="浏览…"
                        Width="76" Height="32" Margin="8,0,0,0"
                        Padding="10,0" FontSize="13"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        Click="BrowseButton_Click" />
            </Grid>
            <TextBlock x:Name="PathHint"
                       Text="留空则安装到默认目录 C:\Program Files (x86)\FolderCrypto"
                       Margin="0,8,0,0" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

            <ProgressBar x:Name="Progress"
                         Height="4" Margin="0,22,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <!-- ============ 底部：状态 + 按钮 ============ -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0" Margin="0,0,12,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" />

                <Button x:Name="CancelButton"
                        Grid.Column="1" Content="取消"
                        Width="80" Height="34" Margin="0,0,8,0"
                        FontSize="13" IsCancel="True"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        Click="CancelButton_Click" />

                <Button x:Name="InstallButton"
                        Grid.Column="2" Content="安装"
                        Width="88" Height="34" FontSize="13"
                        IsDefault="True"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White" BorderThickness="0"
                        Click="InstallButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
