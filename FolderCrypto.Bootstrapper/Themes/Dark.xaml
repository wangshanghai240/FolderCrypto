<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：与 Light.xaml 相同的键。 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="CardBackground"  Color="#2B2B2B" />
    <SolidColorBrush x:Key="TextPrimary"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary"   Color="#C8C8C8" />
    <SolidColorBrush x:Key="AccentBrush"     Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHover"     Color="#6BCDFF" />
    <SolidColorBrush x:Key="ControlBackground" Color="#333333" />
    <SolidColorBrush x:Key="ControlBorder"   Color="#4D4D4D" />
    <SolidColorBrush x:Key="Divider"         Color="#3A3A3A" />
    <SolidColorBrush x:Key="SuccessBrush"    Color="#6CCB5F" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="#FF99A4" />
    <!-- 按钮悬停/按下叠加：半透明黑使悬停时背景变暗，保证按钮文字可读 -->
    <SolidColorBrush x:Key="ButtonHoverOverlay"   Color="#33000000" />
    <SolidColorBrush x:Key="ButtonPressedOverlay" Color="#66000000" />
</ResourceDictionary>
