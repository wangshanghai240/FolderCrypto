<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：控件统一用 DynamicResource 引用这些键，切换主题即时生效。 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F7F7F7" />
    <SolidColorBrush x:Key="CardBackground"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary"     Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary"   Color="#616161" />
    <SolidColorBrush x:Key="AccentBrush"     Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHover"     Color="#006CBD" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder"   Color="#C7C7C7" />
    <SolidColorBrush x:Key="Divider"         Color="#E4E4E4" />
    <SolidColorBrush x:Key="SuccessBrush"    Color="#107C10" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="#C42B1C" />
    <!-- 按钮悬停/按下叠加：半透明黑使悬停时背景轻微变暗，保证文字可读 -->
    <SolidColorBrush x:Key="ButtonHoverOverlay"   Color="#15000000" />
    <SolidColorBrush x:Key="ButtonPressedOverlay" Color="#2D000000" />
</ResourceDictionary>
