    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FolderCrypto">
        <Component Id="StartMenuShortcut" Guid="{D462FB33-A111-36AE-192C-B1DA4E1740CA}">
          <Shortcut Id="StartMenuAppShortcut" Name="FolderCrypto"
                    Description="文件夹/文件加密工具"
                    Target="[INSTALLFOLDER]FolderCrypto.App.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="appIcon" />
          <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\FolderCrypto" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\FolderCrypto" Name="AppPath" Type="string" Value="[INSTALLFOLDER]FolderCrypto.App.exe" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{8CCAF229-EA8E-BE12-8548-4DA76E5CE888}">
        <Shortcut Id="DesktopAppShortcut" Name="FolderCrypto"
                  Description="文件夹/文件加密工具"
                  Target="[INSTALLFOLDER]FolderCrypto.App.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="appIcon" />
        <RegistryValue Root="HKCU" Key="Software\FolderCrypto" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 卸载时清理右键菜单残留（HKCU，无需管理员）。 -->
    <Component Id="ContextMenuCleanup" Guid="{75322B16-616A-2100-4DB2-BA2FAEC5430F}" Directory="INSTALLFOLDER">
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoToggle" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoToggle" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\FolderCryptoEncrypt" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoEncrypt" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoDecrypt" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoEncrypt" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoDecrypt" Action="removeOnUninstall" />
    </Component>

    <!-- 安装时写入的右键菜单注册表项（对应 ContextMenuRegistrar，安装即注册、卸载即删除）。 -->
    <Component Id="CtxMenu_1" Guid="{24E34CED-064F-8B42-D5DD-A333C548F7FB}" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoToggle" Type="string" Value="加密 / 解密" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoToggle" Name="MUIVerb" Type="string" Value="加密 / 解密" />
        <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoToggle" Name="Icon" Type="string" Value="[INSTALLFOLDER]shell-support\toggle-key.ico" />
        <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoToggle\command" Type="string" Value="&quot;[INSTALLFOLDER]FolderCrypto.App.exe&quot; toggle &quot;%1&quot;" />
    </Component>
    <Component Id="CtxMenu_2" Guid="{88D1A7AD-1501-3B18-0D6B-D91922E01D96}" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoToggle" Type="string" Value="加密 / 解密" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoToggle" Name="MUIVerb" Type="string" Value="加密 / 解密" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoToggle" Name="Icon" Type="string" Value="[INSTALLFOLDER]shell-support\toggle-key.ico" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FolderCryptoToggle\command" Type="string" Value="&quot;[INSTALLFOLDER]FolderCrypto.App.exe&quot; toggle &quot;%1&quot;" />
    </Component>
    <Component Id="CtxMenu_3" Guid="{9FA98003-E2B4-8F6E-6D60-277D6054126B}" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\FolderCryptoEncrypt" Type="string" Value="加密选中" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\FolderCryptoEncrypt" Name="MUIVerb" Type="string" Value="加密选中" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\FolderCryptoEncrypt" Name="Icon" Type="string" Value="[INSTALLFOLDER]shell-support\overlay-lock.ico" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\FolderCryptoEncrypt\command" Type="string" Value="&quot;[INSTALLFOLDER]FolderCrypto.App.exe&quot; encrypt-here &quot;%1&quot;" />
    </Component>


    <!-- 原生 Shell DLL 的 COM 类注册 + 锁图标覆盖层登记（干净安装即可用）。 -->
    <Component Id="ShellNativeCom" Guid="{09A68652-0701-3B5B-F7C5-0EEC3697CBA2}" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{F8A2C000-1234-4A5B-9C6D-7E8F9A0B1C2D}">
          <RegistryValue Type="string" Value="FolderCrypto Lock Overlay Handler" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]shell-support\FolderCrypto.ShellNative.dll" KeyPath="yes" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{F8A2B000-1234-4A5B-9C6D-7E8F9A0B1C2D}">
          <RegistryValue Type="string" Value="FolderCrypto Encrypt Menu Command Handler" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]shell-support\FolderCrypto.ShellNative.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{F8A2C100-1234-4A5B-9C6D-7E8F9A0B1C2D}">
          <RegistryValue Type="string" Value="FolderCrypto Decrypt Menu Command Handler" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]shell-support\FolderCrypto.ShellNative.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>    </Component>
    <Component Id="OverlayReg" Guid="{2BF5597B-ADDC-DA7E-97C8-831FC9DD814C}" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\  FolderCryptoLock">
          <RegistryValue Type="string" Value="{F8A2C000-1234-4A5B-9C6D-7E8F9A0B1C2D}" KeyPath="yes" />
        </RegistryKey>
    </Component>
    <Property Id="ARPPRODUCTICON" Value="appIcon" />

    <!-- 引入自定义安装 UI（ui.wxs，含目录选择） -->
    <UI>
      <UIRef Id="FcWixUI" />
    </UI>

    <Feature Id="MainFeature" Title="FolderCrypto" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="CtxMenu_1" />
      <ComponentRef Id="CtxMenu_2" />
      <ComponentRef Id="CtxMenu_3" />
      <ComponentRef Id="ShellNativeCom" />
      <ComponentRef Id="OverlayReg" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ContextMenuCleanup" />
    </Feature>

    <!-- 卸载时移除「按用户注册」的一级右键菜单 sparse 包。
         perMachine 的 MSI 卸载以 SYSTEM 运行，无法直接删某个用户的注册，
         故用 -AllUsers 遍历所有用户移除；Return=ignore 确保清理失败也不阻塞卸载。
         仅在“真正卸载”时触发（升级时 UPGRADINGPRODUCTCODE 已设置，跳过，由新版本重新注册）。 -->
    <CustomAction Id="RemoveSparseMenuPkg"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-AppxPackage -AllUsers -Name FolderCrypto.SparseMenu | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveSparseMenuPkg" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

