        <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\FolderCryptoDecrypt\command" Type="string" Value="&quot;[INSTALLFOLDER]FolderCrypto.App.exe&quot; decrypt &quot;%1&quot;" />
